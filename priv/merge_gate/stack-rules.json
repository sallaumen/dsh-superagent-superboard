  "npm-lint": {"stack": "JavaScript / TypeScript", "markers": ["package.json"], "mode": "changed", "paths": ["*.js", "*.jsx", "*.ts", "*.tsx", "*.mjs", "*.cjs", "*.css", "*.scss", "*.html", "*.vue", "*.svelte", "package*.json", "*-lock.*", "pnpm-lock.yaml", "yarn.lock", "assets/*", "public/*", "src/*", "*.heex", "playwright*", "cypress/*"], "manifest": "package.json", "script": "lint"},
  "npm-build": {"stack": "JavaScript / TypeScript", "markers": ["package.json"], "mode": "changed", "paths": ["*.js", "*.jsx", "*.ts", "*.tsx", "*.mjs", "*.cjs", "*.css", "*.scss", "*.html", "*.vue", "*.svelte", "package*.json", "*-lock.*", "pnpm-lock.yaml", "yarn.lock", "assets/*", "public/*", "src/*", "*.heex", "playwright*", "cypress/*"], "manifest": "package.json", "script": "build"},
  "npm-e2e": {"stack": "JavaScript / TypeScript", "markers": ["package.json"], "mode": "changed", "paths": ["*.js", "*.jsx", "*.ts", "*.tsx", "*.mjs", "*.cjs", "*.css", "*.scss", "*.html", "*.vue", "*.svelte", "package*.json", "*-lock.*", "pnpm-lock.yaml", "yarn.lock", "assets/*", "public/*", "src/*", "*.heex", "playwright*", "cypress/*"], "manifest": "package.json", "script": "test:e2e"},
  "cargo-format": {"stack": "Rust", "markers": ["Cargo.toml"], "mode": "changed", "paths": ["*.rs", "Cargo.*"]},
  "cargo-test": {"stack": "Rust", "markers": ["Cargo.toml"], "mode": "always", "paths": ["*.rs", "Cargo.*"]},
  "pytest": {"stack": "Python", "markers": ["pytest.ini", "pyproject.toml", "requirements.txt", "requirements-dev.txt", "setup.cfg", "tox.ini", "Pipfile"], "mode": "always", "paths": ["*.py"], "contains": "pytest"},
