+/** Once a managed delivery starts, do not let another tool race its checks or change the worker identity. */
+function publicationStopped(ticket: Ticket): boolean {
+  const cwd = ticket.execution?.directory
+  if (!cwd) return false
+  const dot = join(cwd, '.git')
+  try {
+    const dir = statSync(dot).isDirectory() ? dot : resolve(cwd, readFileSync(dot, 'utf8').trim().replace(/^gitdir: /, ''))
+    const receipt = JSON.parse(readFileSync(join(dir, 'superboard-assignment.json'), 'utf8'))
+    return receipt.assignment === ticket.assignments.at(-1)?.id && receipt.blocked === true
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code !== 'ENOENT'
+  }
+}
