diff --git a/src/sources/github.ts b/src/sources/github.ts
index f9b80b6..1d7413e 100644
--- a/src/sources/github.ts
+++ b/src/sources/github.ts
@@ -452,8 +452,23 @@ async function pollThread(ctx: SourceContext, round: Round, thread: Thread): Pro
   const checkpoint = KV.github.cursor(number)
   const since = ctx.state.get(checkpoint) ?? thread.createdAt
   if (thread.meta.isPr === true) {
-    const pr = await pull(ctx, round, number)
-    await intakeComments(ctx, { number, isPr: true, url: pr.html_url, prAuthor: pr.user.login }, since, round)
+    // A merged PR cannot reopen. Keep reading its discussion, but refresh
+    // mutable metadata (e.g. renamed accounts) only once per hour.
+    const repo = ctx.deployment.repository
+    const checked = thread.meta.mergedDetailAt
+    const age = Date.now() - (typeof checked === 'number' ? checked : NaN)
+    let ref: PullRef
+    if (thread.meta.mergedDetailRepo === repo && age >= 0 && age < 3_600_000
+        && typeof thread.meta.url === 'string' && typeof thread.meta.prAuthor === 'string') {
+      ref = { number, isPr: true, url: thread.meta.url, prAuthor: thread.meta.prAuthor }
+    } else {
+      const pr = await pull(ctx, round, number)
+      ref = { number, isPr: true, url: pr.html_url, prAuthor: pr.user.login }
+      if (pr.merged === true) ctx.threads.patch(thread.key, {
+        mergedDetailAt: Date.now(), mergedDetailRepo: repo, url: pr.html_url, prAuthor: pr.user.login,
+      })
+    }
+    await intakeComments(ctx, ref, since, round)
   } else await intakeComments(ctx, { number, isPr: false }, since, round)
   ctx.state.set(checkpoint, cursorAt(round.started))
 }
