+/** At most one extra PR detail per normal minute, only in the first 15 minutes of review. */
+export async function checkOneReview(ctx: SourceContext, signal: AbortSignal, previous: number): Promise<number> {
+  if (signal.aborted) return previous
+  const now = Date.now()
+  const numbers = new Set<number>()
+  for (const ticket of ctx.tickets.open()) {
+    const report = ticket.assignments.at(-1)?.report
+    if (report?.state !== 'ready') continue
+    const age = now - Date.parse(report.at)
+    if (!(age >= 0 && age < 15 * 60_000)) continue
+    for (const follow of ticket.follows ?? []) {
+      const match = !follow.closed && follow.own && /^github:([1-9][0-9]*)$/.exec(follow.thread)
+      if (match && Number.isSafeInteger(Number(match[1]))) numbers.add(Number(match[1]))
+    }
+  }
+  const ordered = [...numbers].sort((a, b) => a - b)
+  const n = ordered.find(n => n > previous) ?? ordered[0]
+  if (n === undefined) return previous
+  try {
+    const pr = await readPull(ctx, n, AbortSignal.any([signal, AbortSignal.timeout(5000)]))
+    if (!signal.aborted && (pr.merged || pr.state === 'closed')) {
+      await observePull(ctx, pr)
+      ctx.report('github', { state: 'ready', detail: 'Review midpoint: PR #' + n + (pr.merged ? ' merged' : ' closed'), at: new Date().toISOString() })
+    }
+  } catch { /* Rotate even after a failed read; never retry in this window. */ }
+  return n
+}
 interface Round {
   started: string; signal?: AbortSignal | undefined
   pulls: Map<number, Promise<Pull>>; read: Set<number>; failures: string[]; dropped: number[]; abandoned: number[]
