+  /** Accept a board-owned relation as a fact, never as a new mandate or as a human trigger. */
+  completeDependencies(ticketId: string, repository: string, number: number, assignmentId: string,
+    children: { number: number; ticket: string }[]): 'delivered' | 'already_delivered' | 'ineligible' {
+    const parent = this.require(ticketId)
+    const owns = (t: Ticket, n: number) => t.mandate.basis.source === 'github' && t.mandate.basis.scope?.number === n
+      && t.mandate.basis.scope?.kind === 'issue' && t.channels.some(c => c.source === 'github'
+        && c.thread === `github:${n}` && c.address.url?.toLowerCase() === `https://github.com/${repository.toLowerCase()}/issues/${n}`)
+    if (!owns(parent, number) || !children.length || new Set(children.map(c => c.number)).size !== children.length) return 'ineligible'
+    const id = 'dependency:' + children.map(c => c.ticket).sort().join(':')
+    if (parent.inputs.some(input => input.id === id)) return 'already_delivered'
+    const worker = runningAssignment(parent)
+    if (!liveTicket(parent) || parent.mandate.strength !== 'explicit' || !this.policy().revalidate(parent.mandate)
+        || !worker || worker.id !== assignmentId || !worker.idleAt || !worker.report || worker.report.state !== 'blocked'
+        || parent.undelivered.length || (worker.deliveredAt && worker.deliveredAt > worker.report.at)) return 'ineligible'
+    const ends: string[] = []
+    for (const child of children) {
+      const t = this.repo.tickets.get(child.ticket)
+      if (!t || t.id === parent.id || !owns(t, child.number) || !t.ended || !['completed','merged'].includes(t.ended.outcome)
+          || t.ended.by === 'human') return 'ineligible'
+      ends.push(t.ended.at)
+    }
+    if (!ends.some(at => at > worker.report!.at)) return 'ineligible'
+    const links = children.map(c => `https://github.com/${repository}/issues/${c.number}`).join(', ')
+    this.addInput(parent, { id, kind: 'text', at: this.now(),
+      text: `The board verified completion of the linked prerequisite(s): ${links}. Read their results and the latest comments on your original issue #${number}. Resume the same assignment within its existing mandate. If another prerequisite still blocks it, report that instead. Do not open a replacement ticket.` })
+    return 'delivered'
+  }
