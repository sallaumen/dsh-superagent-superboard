+
+describe('completed board dependencies', () => {
+  it('targets the idle assignment once even after delivery, and rejects stale or unfinished evidence', () => {
+    const h = harness()
+    const make = (id: string, n: number) => {
+      const ticketId = accepted(h, id, 't'+id).ticketId!
+      const ticket = h.repo.tickets.get(ticketId)!
+      ticket.mandate.basis = {via:'listed', scope:{kind:'issue',number:n},source:'github'}
+      ticket.channels = [{source:'github',thread:'github:'+n,address:{url:'https://github.com/o/r/issues/'+n}}]
+      h.repo.tickets.save(ticket)
+      return ticketId
+    }
+    const parent = make('1', 471), child = make('2', 472)
+    h.engine.report(parent, {state:'blocked',summary:'only the receipt is missing'})
+    const p = h.repo.tickets.get(parent)!, a = runningAssignment(p)!
+    a.idleAt = a.report!.at; h.repo.tickets.save(p)
+    const args = [{number:472,ticket:child}]
+    const deliver = () => h.engine.completeDependencies(parent,'o/r',471,a.id,args)
+    expect(deliver()).toBe('ineligible')
+    h.tick(1000); h.engine.report(child, {state:'ready',summary:'receipt delivered'})
+    expect(h.engine.completeDependencies(parent,'o/other',471,a.id,args)).toBe('ineligible')
+    expect(h.engine.completeDependencies(parent,'o/r',471,'old-assignment',args)).toBe('ineligible')
+    expect(deliver()).toBe('delivered')
+    h.settle()
+    expect(deliver()).toBe('already_delivered')
+    const after = h.repo.tickets.get(parent)!
+    expect(after.assignments.map(v=>v.id)).toEqual([a.id])
+    expect(after.inputs.filter(v=>v.id.startsWith('dependency:'))).toHaveLength(1)
+    expect(h.delivered.filter(([id,input])=>id===parent && input.startsWith('dependency:'))).toHaveLength(1)
+  })
+})
