# The committed list of variables. Copy the ones you need into `.env.local`
# (gitignored), which is what the app actually reads.

# DeepSeek -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Gemini -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: pin one provider (deepseek | gemini | openai).
# Without it, the first provider with a key answers.
# AI_PROVIDER=deepseek

# ElevenLabs -- https://elevenlabs.io/app/settings/api-keys
# The voice client (TTS, STT and voices) reads the key from the environment.
ELEVENLABS_API_KEY=

# Optional: the voice the board speaks with (an id from
# https://elevenlabs.io/app/voice-lab) and the models it uses.
# The board's Voice section picks and saves the voice and the TTS model
# from the UI; these variables override the picks. Defaults: George /
# eleven_flash_v2_5 / scribe_v2.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=
# ELEVENLABS_STT_MODEL=
