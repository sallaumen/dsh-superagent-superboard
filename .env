# The committed list of variables. Copy the ones you need into `.env.local`
# (gitignored), which is what the app actually reads.

# DeepSeek -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Gemini -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: pin one provider (deepseek | gemini | openai).
# Without it, the first provider with a key answers.
# AI_PROVIDER=deepseek
